{
	"name": "@canvist/headless",
	"version": "0.1.0",
	"license": "Unlicense",
	"exports": {
		".": "./src/mod.ts",
		"./extensions": "./src/extensions.generated.ts",
		"./full": "./src/full.ts",
		"./scene": "./src/scene.ts",
		"./ssr": "./src/ssr.ts"
	},
	"publish": {
		"include": [
			"src/**/*.ts",
			"wasm/*.js",
			"wasm/*.d.ts",
			"wasm/*.wasm",
			"wasm-full/*.js",
			"wasm-full/*.d.ts",
			"wasm-full/*.wasm",
			"wasm-scene/*.js",
			"wasm-scene/*.d.ts",
			"wasm-scene/*.wasm",
			"wasm-ssr/*.js",
			"wasm-ssr/*.d.ts",
			"wasm-ssr/*.wasm",
			"readme.md"
		],
		"exclude": ["!wasm/", "!wasm-full/", "!wasm-scene/", "!wasm-ssr/"]
	},
	"tasks": {
		"test": "deno test --allow-read --allow-net --allow-env tests/ examples/",
		"bench": "deno run --allow-read bench/overhead.ts",
		"server": "deno run --allow-read --allow-net examples/server/main.ts"
	}
}
