{
	"name": "@canvist/web",
	"version": "0.1.0",
	"description": "The canvist editor for the browser: a canvas that wraps text exactly like canvist's server-rendered HTML, with typed commands and a font plugin.",
	"license": "Unlicense",
	"homepage": "https://github.com/canvist/canvist/tree/main/packages/canvist-web#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canvist/canvist.git",
		"directory": "packages/canvist-web"
	},
	"bugs": {
		"url": "https://github.com/canvist/canvist/issues",
		"email": "support@canvist.dev"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"default": "./dist/mod.js"
		},
		"./fonts": {
			"types": "./dist/fonts.d.ts",
			"default": "./dist/fonts.js"
		},
		"./wasm/canvist_web_bg.wasm": "./wasm/canvist_web_bg.wasm"
	},
	"files": [
		"dist",
		"wasm/*.js",
		"wasm/*.d.ts",
		"wasm/*.wasm"
	],
	"sideEffects": false,
	"scripts": {
		"build:wasm": "cd ../.. && wasm-pack build crates/canvist_web --target web --profile wasm-web --no-opt --out-dir ../../packages/canvist-web/wasm --no-pack && rm packages/canvist-web/wasm/.gitignore && cd packages/canvist-web && node scripts/optimize-wasm.ts",
		"check:types": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"test:browser": "playwright test",
		"dev": "vite --config tests/vite.config.ts",
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"size": "vite build --config tests/bundle/vite.config.ts --logLevel error && node scripts/bundle-size.ts --budget 354000"
	},
	"dependencies": {
		"@canvist/headless": "file:../canvist-headless"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.0",
		"@types/node": "^24.0.0",
		"@types/pngjs": "^6.0.5",
		"binaryen": "^132.0.0",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"ssim.js": "^3.5.0",
		"subset-font": "^2.9.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.0"
	}
}
