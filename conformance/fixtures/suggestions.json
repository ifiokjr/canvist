{
	"description": "Suggestions and the atoms they insert: mentions, hashtags, and emoji.",
	"cases": [
		{
			"name": "suggests a mention while typing and inserts it with a space",
			"requires": ["extensions"],
			"extensions": ["mention"],
			"steps": [
				{ "op": "typeText", "text": "Hi @ad" },
				{ "op": "query", "query": "mentionSuggestion", "expect": { "char": "@", "query": "ad" } },
				{ "op": "run", "command": "insertMention", "args": { "id": "7", "label": "Ada" }, "applied": true },
				{ "op": "query", "query": "mentionSuggestion", "expect": null },
				{ "op": "typeText", "text": "x" }
			],
			"expect": {
				"text": "Hi @Ada x",
				"html": "<p>Hi <span data-type=\"mention\" data-id=\"7\" data-label=\"Ada\" data-mention-suggestion-char=\"@\">@Ada</span> x</p>"
			}
		},
		{
			"name": "Escape dismisses a suggestion and Backspace reopens a mention",
			"requires": ["extensions"],
			"extensions": ["mention"],
			"steps": [
				{ "op": "typeText", "text": "@ad" },
				{ "op": "press", "key": "Escape" },
				{ "op": "query", "query": "mentionSuggestion", "expect": null },
				{ "op": "run", "command": "dismissMentionSuggestion", "applied": false },
				{ "op": "typeText", "text": " @g" },
				{ "op": "run", "command": "insertMention", "args": { "id": "3", "label": "Grace" }, "applied": true },
				{ "op": "press", "key": "Backspace" },
				{ "op": "press", "key": "Backspace" },
				{ "op": "query", "query": "mentionSuggestion", "expect": { "char": "@", "query": "" } }
			],
			"expect": { "text": "@ad @" }
		},
		{
			"name": "reads TipTap mentions from JSON and HTML",
			"requires": ["extensions"],
			"extensions": ["mention"],
			"input": {
				"format": "json",
				"content": {
					"type": "doc",
					"content": [{ "type": "paragraph", "content": [{ "type": "mention", "attrs": { "id": "1", "label": "Linus" } }] }]
				}
			},
			"expect": { "text": "@Linus", "markdown": "@Linus" }
		},
		{
			"name": "turns shortcodes into emoji and searches the table",
			"requires": ["extensions"],
			"extensions": ["emoji"],
			"steps": [
				{ "op": "typeText", "text": "ship it :rocket: :nope: :tad" },
				{ "op": "query", "query": "emojiSuggestion", "expect": { "char": ":", "query": "tad" } },
				{ "op": "query", "query": "searchEmoji", "args": { "query": "tad", "limit": 1 }, "expect": [{ "name": "tada", "emoji": "🎉" }] },
				{ "op": "run", "command": "setEmoji", "args": { "name": "tada" }, "applied": true },
				{ "op": "run", "command": "setEmoji", "args": { "name": "not-an-emoji" }, "applied": false }
			],
			"expect": {
				"text": "ship it 🚀 :nope: 🎉 ",
				"json": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{ "type": "text", "text": "ship it " },
								{ "type": "emoji", "attrs": { "emoji": "🚀", "name": "rocket" } },
								{ "type": "text", "text": " :nope: " },
								{ "type": "emoji", "attrs": { "emoji": "🎉", "name": "tada" } },
								{ "type": "text", "text": " " }
							]
						}
					]
				}
			}
		},
		{
			"name": "marks hashtags as they are typed and lists them",
			"requires": ["extensions"],
			"extensions": ["hashtag"],
			"steps": [
				{ "op": "typeText", "text": "#rust and #wasm. #ca" },
				{ "op": "query", "query": "hashtagSuggestion", "expect": { "char": "#", "query": "ca" } },
				{ "op": "run", "command": "insertHashtag", "args": { "tag": "canvas" }, "applied": true },
				{ "op": "query", "query": "hashtags", "expect": ["canvas", "rust", "wasm"] }
			],
			"expect": {
				"html": "<p><span data-type=\"hashtag\" data-tag=\"rust\">#rust</span> and <span data-type=\"hashtag\" data-tag=\"wasm\">#wasm</span>. <span data-type=\"hashtag\" data-tag=\"canvas\">#canvas</span> </p>"
			}
		},
		{
			"name": "keeps atoms and hashtags through Yjs",
			"requires": ["collab", "extensions"],
			"extensions": ["mention", "emoji", "hashtag"],
			"steps": [
				{ "op": "share", "clientId": 5 },
				{ "op": "typeText", "text": "@a" },
				{ "op": "run", "command": "insertMention", "args": { "id": "1", "label": "Ann" }, "applied": true },
				{ "op": "typeText", "text": ":heart: #team " },
				{ "op": "rejoin", "clientId": 6 }
			],
			"expect": {
				"html": "<p><span data-type=\"mention\" data-id=\"1\" data-label=\"Ann\" data-mention-suggestion-char=\"@\">@Ann</span> <span data-type=\"emoji\" data-name=\"heart\" data-emoji=\"❤️\">❤️</span> <span data-type=\"hashtag\" data-tag=\"team\">#team</span> </p>"
			}
		},
		{
			"name": "undoes and redoes an inserted mention, bringing its suggestion back",
			"requires": ["extensions"],
			"extensions": ["mention"],
			"steps": [
				{ "op": "typeText", "text": "Hi @ad" },
				{ "op": "run", "command": "insertMention", "args": { "id": "7", "label": "Ada" }, "applied": true },
				{ "op": "expect", "text": "Hi @Ada ", "selection": { "anchor": { "path": [0], "offset": 5 }, "head": { "path": [0], "offset": 5 } } },
				{ "op": "undo", "applied": true },
				{ "op": "query", "query": "mentionSuggestion", "expect": { "char": "@", "query": "ad" } },
				{ "op": "expect", "text": "Hi @ad", "selection": { "anchor": { "path": [0], "offset": 6 }, "head": { "path": [0], "offset": 6 } } },
				{ "op": "redo", "applied": true }
			],
			"expect": { "text": "Hi @Ada ", "selection": { "anchor": { "path": [0], "offset": 5 }, "head": { "path": [0], "offset": 5 } } }
		},
		{
			"name": "atom commands need a caret and reject invalid arguments",
			"requires": ["extensions"],
			"extensions": ["mention", "hashtag", "emoji"],
			"steps": [
				{ "op": "typeText", "text": "@a" },
				{ "op": "can", "command": "insertMention", "args": { "id": "1" }, "expect": true },
				{ "op": "can", "command": "setEmoji", "args": { "name": "smile" }, "expect": true },
				{ "op": "select", "anchor": { "path": [0], "offset": 0 }, "head": { "path": [0], "offset": 2 } },
				{ "op": "can", "command": "insertMention", "args": { "id": "1" }, "expect": false },
				{ "op": "can", "command": "insertHashtag", "args": { "tag": "a" }, "expect": false },
				{ "op": "select", "anchor": { "path": [0], "offset": 2 } },
				{ "op": "run", "command": "insertMention", "args": {}, "error": "invalidArgs" },
				{ "op": "run", "command": "insertMention", "args": { "id": 7 }, "error": "invalidArgs" },
				{ "op": "run", "command": "insertMention", "args": { "id": "7", "label": true }, "error": "invalidArgs" },
				{ "op": "run", "command": "insertHashtag", "args": {}, "error": "invalidArgs" },
				{ "op": "run", "command": "setEmoji", "args": { "name": 1 }, "error": "invalidArgs" },
				{ "op": "query", "query": "searchEmoji", "args": {}, "error": "invalidArgs" },
				{ "op": "query", "query": "searchEmoji", "args": { "query": "a", "limit": "ten" }, "error": "invalidArgs" },
				{ "op": "run", "command": "setEmoji", "args": { "name": "not_an_emoji" }, "applied": false }
			],
			"expect": { "text": "@a" }
		},
		{
			"name": "atom commands are unknown without their extensions",
			"steps": [
				{ "op": "run", "command": "insertMention", "args": { "id": "1" }, "error": "unknownName" },
				{ "op": "run", "command": "setEmoji", "args": { "name": "smile" }, "error": "unknownName" },
				{ "op": "query", "query": "hashtags", "error": "unknownName" },
				{ "op": "typeText", "text": ":smile: #tag " }
			],
			"expect": { "text": ":smile: #tag ", "html": "<p>:smile: #tag </p>" }
		},
		{
			"name": "Backspace right after a shortcode or a hashtag undoes the input rule",
			"requires": ["extensions"],
			"extensions": ["emoji", "hashtag"],
			"steps": [
				{ "op": "typeText", "text": "hi :smile:" },
				{ "op": "expect", "text": "hi 😄" },
				{ "op": "press", "key": "Backspace" },
				{ "op": "expect", "text": "hi :smile:" },
				{ "op": "typeText", "text": " #rust " },
				{ "op": "query", "query": "hashtags", "expect": ["rust"] },
				{ "op": "press", "key": "Backspace" },
				{ "op": "query", "query": "hashtags", "expect": [] },
				{ "op": "undo", "applied": true },
				{ "op": "query", "query": "hashtags", "expect": ["rust"] }
			],
			"expect": { "html": "<p>hi :smile: <span data-type=\"hashtag\" data-tag=\"rust\">#rust</span> </p>" }
		},
		{
			"name": "searches emoji with a limit and in any case",
			"requires": ["extensions"],
			"extensions": ["emoji"],
			"steps": [
				{ "op": "query", "query": "searchEmoji", "args": { "query": "TADA", "limit": 1 }, "expect": [{ "name": "tada", "emoji": "🎉" }] },
				{
					"op": "query",
					"query": "searchEmoji",
					"args": { "query": "thumbs" },
					"expect": [{ "name": "thumbsdown", "emoji": "👎" }, { "name": "thumbsup", "emoji": "👍" }]
				},
				{ "op": "query", "query": "searchEmoji", "args": { "query": "smile", "limit": 0 }, "expect": [] },
				{ "op": "query", "query": "searchEmoji", "args": { "query": "zzzz" }, "expect": [] }
			],
			"expect": { "text": "" }
		},
		{
			"name": "pastes TipTap HTML atoms and hashtags",
			"requires": ["extensions"],
			"extensions": ["mention", "emoji", "hashtag"],
			"steps": [
				{
					"op": "paste",
					"format": "html",
					"content": "<p>a <span data-type=\"mention\" data-id=\"9\" data-label=\"Zed\" data-mention-suggestion-char=\"+\">+Zed</span> <span data-type=\"emoji\" data-name=\"tada\" data-emoji=\"🎉\">🎉</span> <span data-type=\"hashtag\" data-tag=\"x\">#x</span> b</p>"
				},
				{ "op": "query", "query": "hashtags", "expect": ["x"] },
				{ "op": "expect", "selection": { "anchor": { "path": [0], "offset": 10 }, "head": { "path": [0], "offset": 10 } } }
			],
			"expect": {
				"text": "a +Zed 🎉 #x b",
				"markdown": "a +Zed 🎉 #x b",
				"json": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{ "type": "text", "text": "a " },
								{ "type": "mention", "attrs": { "label": "Zed", "mentionSuggestionChar": "+" } },
								{ "type": "text", "text": " " },
								{ "type": "emoji", "attrs": { "emoji": "🎉", "name": "tada" } },
								{ "type": "text", "text": " " },
								{ "type": "text", "text": "#x", "marks": [{ "type": "hashtag", "attrs": { "tag": "x" } }] },
								{ "type": "text", "text": " b" }
							]
						}
					]
				}
			}
		},
		{
			"name": "reads TipTap JSON atoms that lack canvist's attributes",
			"requires": ["extensions"],
			"extensions": ["mention", "emoji"],
			"input": {
				"format": "json",
				"content": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [{ "type": "mention", "attrs": { "id": "u1" } }, { "type": "text", "text": " " }, { "type": "emoji", "attrs": { "name": "smile" } }]
						}
					]
				}
			},
			"expect": {
				"text": "@u1 :smile:",
				"markdown": "@u1 :smile:",
				"html": "<p><span data-type=\"mention\" data-id=\"u1\">@u1</span> <span data-type=\"emoji\" data-name=\"smile\">:smile:</span></p>"
			}
		},
		{
			"name": "reads a mention without a label from HTML without inventing one",
			"requires": ["extensions"],
			"extensions": ["mention"],
			"input": {
				"format": "html",
				"content": "<p><span data-type=\"mention\" data-id=\"u1\" data-mention-suggestion-char=\"@\">@u1</span> hi <span data-type=\"mention\" data-id=\"3\">@Grace</span></p>"
			},
			"expect": {
				"html": "<p><span data-type=\"mention\" data-id=\"u1\" data-mention-suggestion-char=\"@\">@u1</span> hi <span data-type=\"mention\" data-id=\"3\" data-label=\"Grace\">@Grace</span></p>",
				"json": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{ "type": "mention", "attrs": { "mentionSuggestionChar": "@" } },
								{ "type": "text", "text": " hi " },
								{ "type": "mention", "attrs": { "label": "Grace" } }
							]
						}
					]
				}
			}
		},
		{
			"name": "marks hashtags in pasted text and Markdown",
			"requires": ["extensions"],
			"extensions": ["hashtag"],
			"steps": [
				{ "op": "paste", "format": "text", "content": "tags: #one #two" },
				{ "op": "press", "key": "Enter" },
				{ "op": "paste", "format": "markdown", "content": "see **#docs** and more" },
				{ "op": "query", "query": "hashtags", "expect": ["docs", "one", "two"] }
			],
			"expect": { "markdown": "tags: #one #two\n\nsee **#docs** and more" }
		},
		{
			"name": "keeps mention ids and hashtags through a snapshot, which starts a new history",
			"requires": ["extensions"],
			"extensions": ["mention", "hashtag"],
			"steps": [
				{ "op": "typeText", "text": "@a" },
				{ "op": "run", "command": "insertMention", "args": { "id": "u-7", "label": "Ann" }, "applied": true },
				{ "op": "typeText", "text": "#team " },
				{ "op": "snapshotRoundTrip" },
				{ "op": "query", "query": "hashtags", "expect": ["team"] },
				{ "op": "undo", "applied": false }
			],
			"expect": {
				"html": "<p><span data-type=\"mention\" data-id=\"u-7\" data-label=\"Ann\" data-mention-suggestion-char=\"@\">@Ann</span> <span data-type=\"hashtag\" data-tag=\"team\">#team</span> </p>"
			}
		},
		{
			"name": "undoing an atom on a shared document reaches a new peer",
			"requires": ["collab", "extensions"],
			"extensions": ["mention", "emoji"],
			"steps": [
				{ "op": "share", "clientId": 5 },
				{ "op": "typeText", "text": ":wave: @a" },
				{ "op": "run", "command": "insertMention", "args": { "id": "1", "label": "Ann" }, "applied": true },
				{ "op": "undo", "applied": true },
				{ "op": "rejoin", "clientId": 6 },
				{ "op": "validate", "rejectedBlocks": 0, "waiting": false }
			],
			"expect": { "html": "<p><span data-type=\"emoji\" data-name=\"wave\" data-emoji=\"👋\">👋</span> @a</p>" }
		}
	]
}
