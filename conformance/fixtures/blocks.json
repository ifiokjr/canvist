{
	"description": "Block extensions: details, callouts, and math.",
	"cases": [
		{
			"name": "wraps a block in details, opens, and closes it",
			"requires": ["extensions"],
			"extensions": ["details"],
			"steps": [
				{ "op": "typeText", "text": "Hidden" },
				{ "op": "query", "query": "detailsOpen", "expect": null },
				{ "op": "run", "command": "setDetails", "applied": true },
				{ "op": "typeText", "text": "Spoiler" },
				{ "op": "query", "query": "detailsOpen", "expect": true },
				{ "op": "run", "command": "toggleDetailsOpen", "applied": true },
				{ "op": "query", "query": "detailsOpen", "expect": false },
				{ "op": "press", "key": "Enter" },
				{ "op": "query", "query": "detailsOpen", "expect": true }
			],
			"expect": {
				"html": "<details open><summary>Spoiler</summary><div data-type=\"detailsContent\"><p>Hidden</p></div></details><p></p>",
				"markdown": "<details open>\n<summary>Spoiler</summary>\n\nHidden\n\n</details>"
			}
		},
		{
			"name": "reads TipTap details from HTML",
			"requires": ["extensions"],
			"extensions": ["details"],
			"input": {
				"format": "html",
				"content": "<details><summary>Title</summary><div data-type=\"detailsContent\"><p>Body</p></div></details>"
			},
			"expect": {
				"json": {
					"type": "doc",
					"content": [
						{
							"type": "details",
							"attrs": { "open": false },
							"content": [
								{ "type": "detailsSummary", "content": [{ "type": "text", "text": "Title" }] },
								{
									"type": "detailsContent",
									"content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Body" }] }]
								}
							]
						}
					]
				}
			}
		},
		{
			"name": "toggles a callout and changes its type",
			"requires": ["extensions"],
			"extensions": ["callout"],
			"steps": [
				{ "op": "typeText", "text": "Careful" },
				{ "op": "run", "command": "toggleCallout", "args": { "type": "warning" }, "applied": true },
				{ "op": "query", "query": "calloutType", "expect": "warning" },
				{ "op": "run", "command": "setCalloutType", "args": { "type": "error" }, "applied": true },
				{ "op": "run", "command": "setCalloutType", "args": { "type": "purple" }, "error": "invalidArgs" },
				{ "op": "query", "query": "calloutType", "expect": "error" }
			],
			"expect": {
				"html": "<div data-callout-type=\"error\"><p>Careful</p></div><p></p>",
				"markdown": "> [!CAUTION]\n> Careful"
			}
		},
		{
			"name": "reads GitHub alerts from Markdown as callouts",
			"requires": ["extensions"],
			"extensions": ["callout"],
			"input": { "format": "markdown", "content": "> [!TIP]\n> Try this" },
			"expect": { "html": "<div data-callout-type=\"success\"><p>Try this</p></div>" }
		},
		{
			"name": "types inline and block formulas",
			"requires": ["extensions"],
			"extensions": ["mathematics"],
			"steps": [
				{ "op": "typeText", "text": "Area $$\\pi r^2$$" },
				{ "op": "press", "key": "Enter" },
				{ "op": "typeText", "text": "$$$E = mc^2$$$" }
			],
			"expect": {
				"html": "<p>Area <span data-type=\"inline-math\" data-latex=\"\\pi r^2\">$\\pi r^2$</span></p><div data-type=\"block-math\" data-latex=\"E = mc^2\"></div><p></p>",
				"markdown": "Area $\\pi r^2$\n\n$$\nE = mc^2\n$$"
			}
		},
		{
			"name": "inserts formulas by command and reads them from Markdown",
			"requires": ["extensions"],
			"extensions": ["mathematics"],
			"input": { "format": "markdown", "content": "It costs $5 and $x$\n\n$$\na^2\n$$" },
			"steps": [
				{ "op": "run", "command": "insertBlockMath", "error": "invalidArgs" }
			],
			"expect": {
				"html": "<p>It costs $5 and <span data-type=\"inline-math\" data-latex=\"x\">$x$</span></p><div data-type=\"block-math\" data-latex=\"a^2\"></div>"
			}
		}
	]
}
