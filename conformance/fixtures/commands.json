{
	"description": "Selections, named commands and queries with typed arguments, typing with input rules, keys, paste, and undo.",
	"cases": [
		{
			"name": "toggles bold over a word and reports it active",
			"input": { "format": "markdown", "content": "Hello world" },
			"steps": [
				{ "op": "select", "anchor": { "path": [0], "offset": 6 }, "head": { "path": [0], "offset": 11 } },
				{ "op": "query", "query": "isBold", "expect": false },
				{ "op": "can", "command": "toggleBold", "expect": true },
				{ "op": "expect", "markdown": "Hello world" },
				{ "op": "run", "command": "toggleBold", "applied": true },
				{ "op": "query", "query": "isBold", "expect": true }
			],
			"expect": {
				"markdown": "Hello **world**",
				"selection": { "anchor": { "path": [0], "offset": 6 }, "head": { "path": [0], "offset": 11 } }
			}
		},
		{
			"name": "offsets count UTF-16 code units",
			"input": { "format": "text", "content": "a😀b" },
			"steps": [
				{ "op": "select", "anchor": { "path": [0], "offset": 3 }, "head": { "path": [0], "offset": 4 } },
				{ "op": "insertText", "text": "c" },
				{ "op": "select", "anchor": { "path": [0], "offset": 2 }, "error": "invalidPosition" }
			],
			"expect": {
				"text": "a😀c",
				"selection": { "anchor": { "path": [0], "offset": 4 }, "head": { "path": [0], "offset": 4 } }
			}
		},
		{
			"name": "positions address blocks inside lists by path",
			"input": { "format": "markdown", "content": "Intro\n\n- first\n- second" },
			"steps": [
				{ "op": "select", "anchor": { "path": [1, 1, 0], "offset": 0 }, "head": { "path": [1, 1, 0], "offset": 6 } },
				{ "op": "run", "command": "toggleItalic" },
				{ "op": "select", "anchor": { "path": [1], "offset": 0 }, "error": "invalidPosition" },
				{ "op": "select", "anchor": { "path": [9], "offset": 0 }, "error": "invalidPosition" }
			],
			"expect": { "markdown": "Intro\n\n- first\n- *second*" }
		},
		{
			"name": "commands with arguments are checked against their declarations",
			"input": { "format": "markdown", "content": "Title" },
			"steps": [
				{ "op": "run", "command": "setHeading", "args": { "level": 2 }, "applied": true },
				{ "op": "query", "query": "headingLevel", "expect": 2 },
				{ "op": "run", "command": "setHeading", "args": { "level": 7 }, "error": "invalidArgs" },
				{ "op": "run", "command": "setHeading", "args": { "level": "two" }, "error": "invalidArgs" },
				{ "op": "run", "command": "setHeading", "error": "invalidArgs" },
				{ "op": "run", "command": "makeItSparkle", "error": "unknownName" },
				{ "op": "query", "query": "isSparkly", "error": "unknownName" }
			],
			"expect": { "markdown": "## Title", "html": "<h2>Title</h2><p></p>" }
		},
		{
			"name": "a command that does not apply reports so and changes nothing",
			"input": { "format": "markdown", "content": "Plain" },
			"steps": [
				{ "op": "can", "command": "liftListItem", "expect": false },
				{ "op": "run", "command": "liftListItem", "applied": false }
			],
			"expect": { "markdown": "Plain" }
		},
		{
			"name": "links, code blocks, ordered lists, and tasks take typed arguments",
			"input": { "format": "markdown", "content": "site\n\ncode\n\nstep\n\nchore" },
			"steps": [
				{ "op": "select", "anchor": { "path": [0], "offset": 0 }, "head": { "path": [0], "offset": 4 } },
				{ "op": "run", "command": "setLink", "args": { "href": "https://canvist.dev" } },
				{ "op": "query", "query": "linkHref", "expect": "https://canvist.dev" },
				{ "op": "select", "anchor": { "path": [1], "offset": 0 } },
				{ "op": "run", "command": "setCodeBlock", "args": { "language": "ts" } },
				{ "op": "query", "query": "codeBlockLanguage", "expect": "ts" },
				{ "op": "select", "anchor": { "path": [2], "offset": 0 } },
				{ "op": "run", "command": "toggleOrderedList" },
				{ "op": "run", "command": "setOrderedListStart", "args": { "start": 3 } },
				{ "op": "query", "query": "orderedListStart", "expect": 3 },
				{ "op": "select", "anchor": { "path": [3], "offset": 0 } },
				{ "op": "run", "command": "toggleTaskList" },
				{ "op": "run", "command": "setTaskChecked", "args": { "checked": true } },
				{ "op": "query", "query": "isTaskChecked", "expect": true }
			],
			"expect": { "markdown": "[site](https://canvist.dev)\n\n```ts\ncode\n```\n\n3. step\n\n- [x] chore" }
		},
		{
			"name": "typing runs input rules",
			"steps": [
				{ "op": "typeText", "text": "## Notes" },
				{ "op": "press", "key": "Enter" },
				{ "op": "typeText", "text": "- one" },
				{ "op": "press", "key": "Enter" },
				{ "op": "typeText", "text": "two **bold** done" }
			],
			"expect": { "markdown": "## Notes\n\n- one\n- two **bold** done" }
		},
		{
			"name": "inserting text does not run input rules",
			"steps": [
				{ "op": "insertText", "text": "## not a heading" }
			],
			"expect": { "markdown": "\\## not a heading", "text": "## not a heading" }
		},
		{
			"name": "keys run the bound commands",
			"steps": [
				{ "op": "typeText", "text": "- one" },
				{ "op": "press", "key": "Enter" },
				{ "op": "typeText", "text": "two" },
				{ "op": "press", "key": "Tab" },
				{ "op": "expect", "markdown": "- one\n  - two" },
				{ "op": "press", "key": "Shift-Tab" },
				{ "op": "press", "key": "Mod-b" },
				{ "op": "typeText", "text": "!" },
				{ "op": "press", "key": "Backspace" },
				{ "op": "press", "key": "Backspace" },
				{ "op": "press", "key": "Hyper-x", "error": "invalidKey" }
			],
			"expect": { "markdown": "- one\n- tw" }
		},
		{
			"name": "paste merges markdown into the paragraph at the caret, trimmed as CommonMark trims",
			"input": { "format": "markdown", "content": "before after" },
			"steps": [
				{ "op": "select", "anchor": { "path": [0], "offset": 7 } },
				{ "op": "paste", "format": "markdown", "content": "**bold** " },
				{ "op": "select", "anchor": { "path": [0], "offset": 0 } },
				{ "op": "paste", "format": "html", "content": "<em>x</em>" }
			],
			"expect": { "markdown": "*x*before **bold**after" }
		},
		{
			"name": "pasting several blocks splits the paragraph",
			"input": { "format": "markdown", "content": "startend" },
			"steps": [
				{ "op": "select", "anchor": { "path": [0], "offset": 5 } },
				{ "op": "paste", "format": "text", "content": "one\ntwo" }
			],
			"expect": { "text": "startone\ntwoend" }
		},
		{
			"name": "select all and delete keeps the first block's type and the trailing paragraph",
			"input": { "format": "markdown", "content": "# A\n\n- b\n\nc" },
			"steps": [
				{ "op": "selectAll" },
				{ "op": "deleteSelection" }
			],
			"expect": {
				"json": { "type": "doc", "content": [{ "type": "heading", "attrs": { "level": 1 } }, { "type": "paragraph" }] },
				"selection": { "anchor": { "path": [0], "offset": 0 }, "head": { "path": [0], "offset": 0 } }
			}
		},
		{
			"name": "each call is one undo step",
			"steps": [
				{ "op": "insertText", "text": "one" },
				{ "op": "insertText", "text": " two" },
				{ "op": "undo", "applied": true },
				{ "op": "expect", "text": "one" },
				{ "op": "undo", "applied": true },
				{ "op": "expect", "text": "" },
				{ "op": "undo", "applied": false },
				{ "op": "redo", "applied": true },
				{ "op": "redo", "applied": true },
				{ "op": "redo", "applied": false }
			],
			"expect": { "text": "one two" }
		}
	]
}
