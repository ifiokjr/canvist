								{ "type": "taskItem", "attrs": { "checked": true }, "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "done" }] }] }
							]
						}
					]
				}
			},
			"steps": [
				{ "op": "selectAll" },
				{ "op": "run", "command": "clearNodes", "applied": true },
				{ "op": "run", "command": "clearNodes", "applied": false },
				{ "op": "undo", "applied": true },
				{ "op": "expect", "markdown": "```rust\nlet x = 1;\n```\n\n> ### Quote\n\n- [x] done" },
