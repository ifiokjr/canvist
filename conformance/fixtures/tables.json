		{
			"name": "Shift-Tab goes back a cell, and Backspace and Delete stop at a cell's edge",
			"requires": [
				"extensions"
			],
			"extensions": [
				"table"
			],
			"input": {
				"format": "html",
				"content": "<table><tr><td>a</td><td>b</td></tr><tr><td>c</td><td>d</td></tr></table>"
			},
			"steps": [
				{
					"op": "select",
					"anchor": {
						"path": [
							0,
							1,
							1,
							0
						],
						"offset": 1
					}
				},
				{
					"op": "press",
					"key": "Shift-Tab"
				},
				{
					"op": "expect",
					"selection": {
						"anchor": {
							"path": [
								0,
								1,
								0,
								0
							],
							"offset": 0
						},
						"head": {
							"path": [
								0,
								1,
								0,
								0
							],
							"offset": 1
						}
					}
				},
				{
					"op": "select",
					"anchor": {
						"path": [
							0,
							1,
							1,
							0
						],
						"offset": 0
					}
				},
				{
					"op": "press",
					"key": "Backspace"
				},
				{
					"op": "select",
					"anchor": {
						"path": [
							0,
							0,
							0,
							0
						],
						"offset": 1
					}
				},
				{
					"op": "press",
					"key": "Delete"
				},
				{
					"op": "select",
					"anchor": {
						"path": [
							0,
							0,
							0,
							0
						],
						"offset": 0
					}
				},
				{
					"op": "press",
					"key": "Shift-Tab"
				},
				{
					"op": "expect",
					"selection": {
						"anchor": {
							"path": [
								0,
								0,
								0,
								0
							],
							"offset": 0
						},
						"head": {
							"path": [
								0,
								0,
								0,
								0
							],
							"offset": 0
						}
					}
				},
				{
					"op": "run",
					"command": "goToPreviousCell",
					"applied": false
				},
				{
					"op": "select",
					"anchor": {
						"path": [
							0,
							1,
							1,
							0
						],
						"offset": 1
					}
				},
				{
					"op": "run",
					"command": "goToNextCell",
					"applied": false
				}
			],
			"expect": {
				"html": "<table><tbody><tr><td><p>a</p></td><td><p>b</p></td></tr><tr><td><p>c</p></td><td><p>d</p></td></tr></tbody></table><p></p>"
			}
		},
