				"table"
			],
			"steps": [
				{
					"op": "run",
					"command": "insertTable",
					"args": {
						"rows": 1001
					},
					"error": "invalidArgs"
				},
				{
					"op": "run",
					"command": "insertTable",
					"args": {
						"cols": "2"
					},
					"error": "invalidArgs"
				},
				{
					"op": "run",
					"command": "insertTable",
					"args": {
						"withHeaderRow": 1
					},
					"error": "invalidArgs"
				},
