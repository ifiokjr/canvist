---
import "../styles/global.css";
import bricolage from "../fonts/bricolage-grotesque-subset.woff2?url";
import geistMono from "../fonts/geist-mono-subset.woff2?url";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { routePath } from "../lib/route.ts";

interface Props {
	title: string;
	description: string;
	/** Extra font files this page paints above the fold. */
	preloadMono?: boolean;
}

const { title, description, preloadMono = false } = Astro.props;
const canonical = new URL(routePath(Astro.url.pathname), Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const fullTitle = title === "canvist" ? "canvist: the editor that owns every pixel" : `${title} · canvist`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0b13" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="canvist" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
		{preloadMono && <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />}
		<script is:inline>
			// Runs before first paint: a pinned theme never flashes, and motion-only
			// starting states (like the unpainted hero) apply before anything shows.
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
			try {
				const theme = localStorage.getItem("canvist-theme");
				if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
			} catch {
				// Storage can be blocked; the system theme still applies.
			}
		</script>
		<slot name="head" />
	</head>
	<body>
		<Fragment set:html={`<!--
THESIS: canvist is a paint fan deck of its own colour, laid out calmly: a few swatch chips on a white table, each carrying one idea; it refuses the dark devtool hero, feature-card grids and scroll-jacking.
OWN-WORLD: Paper to Paint to Ink tint ramp, chips punched with a rivet, Bricolage Grotesque at display optical size, mono only for measurements, the Wet Caret as the only accent mark, one easing (a long wet settle).
STORY: the caret paints the name; the visitor types into the real engine, sees one document on every platform, watches carets meet, learns the editor is free and the servers are paid, then starts building.
FIRST VIEWPORT: Paper chip; the caret paints the wordmark across the top; headline, one sentence and two actions below left; the film poster below right with the rest of the deck fanned behind it.
FORM: paint fan deck, candidate 7 of 7, seed 79f9cb94; redesigned for clarity and smooth motion.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->`} />
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
