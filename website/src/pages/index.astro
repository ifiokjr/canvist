---
import Cta from "../components/sections/Cta.astro";
import EveryPixel from "../components/sections/EveryPixel.astro";
import Everywhere from "../components/sections/Everywhere.astro";
import FreeForever from "../components/sections/FreeForever.astro";
import Hero from "../components/sections/Hero.astro";
import Together from "../components/sections/Together.astro";
import Base from "../layouts/Base.astro";
---

<Base
	title="canvist"
	description="canvist is an open-source rich-text editor that paints every pixel itself. One Rust core renders to a canvas on the web, desktop, iOS, Android, Flutter, React Native and Lynx, with Yjs collaboration."
>
	<div class="deck">
		<Hero />
		<EveryPixel />
		<Everywhere />
		<Together />
		<FreeForever />
		<Cta />
	</div>
</Base>

<script>
	import "../scripts/landing.ts";
</script>
