---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { enhanceDocsHtml } from "../../components/docs/enhance-html.ts";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { buildDocsNav, EDIT_BASE, firstParagraph, flatten, readSummary } from "../../lib/docs-nav.ts";

export const getStaticPaths = (async () => {
	const entries = await getCollection("docs");
	const nav = buildDocsNav(
		entries.map((entry) => ({ path: entry.id, body: entry.body ?? "" })),
		readSummary(),
	);
	const reading = flatten(nav);

	return Promise.all(
		reading.map(async (link, index) => {
			const entry = entries.find((candidate) => candidate.id === link.path);
			if (entry?.rendered === undefined) throw new Error(`docs/src/${link.path} did not render`);
			const { headings } = await render(entry);
			return {
				params: { slug: link.route === "/docs" ? undefined : link.route.slice("/docs/".length) },
				props: {
					nav,
					link,
					html: enhanceDocsHtml(entry.rendered.html),
					// The rail lists sections and subsections; the page title is the h1.
					headings: headings.filter((heading) => heading.depth === 2 || heading.depth === 3),
					description: firstParagraph(entry.body ?? "") ?? `${link.title}, from the canvist docs.`,
					prev: reading[index - 1],
					next: reading[index + 1],
				},
			};
		}),
	);
}) satisfies GetStaticPaths;

const { nav, link, html, headings, description, prev, next } = Astro.props;
---

<DocsLayout
	title={link.title}
	description={description}
	nav={nav}
	current={link}
	headings={headings}
	prev={prev}
	next={next}
	editUrl={EDIT_BASE + link.path}
>
	<Fragment set:html={html} />
</DocsLayout>
