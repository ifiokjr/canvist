---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { compareVersionsDescending } from "../lib/changelog.ts";

// Only the `user` release stream is here; developer notes never reach this
// collection. The content store does not keep loader order, so sort here.
const releases = (await getCollection("changelog")).sort((left, right) =>
	compareVersionsDescending(left.data.version, right.data.version)
);

const longDate = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const chips = ["1", "2", "3"] as const;
---

<Base title="Changelog" description="What's new in canvist: changes you can see in the editor, the website, canvist Cloud, and its plans and prices.">
	<div class="deck">
		<section class="chip changelog-head" data-chip="4" aria-labelledby="changelog-title">
			<p class="code-label">Changelog</p>
			<h1 id="changelog-title" class="changelog-head__title">What's new</h1>
			<p class="changelog-head__body">
				Changes you can see in canvist, on this website, and in canvist Cloud, including plans and prices. Notes for developers are on <a href="https://github.com/ifiokjr/canvist/releases">GitHub releases</a>.
			</p>
		</section>

		{
			releases.length === 0 ? (
				<section class="chip release" data-chip="1" aria-label="No releases yet">
					<p class="release__empty">Nothing shipped yet. The first release will appear here.</p>
				</section>
			) : (
				releases.map(({ data: release }, index) => (
					<article class="chip release" data-chip={chips[index % chips.length]} aria-labelledby={`release-${release.version}`}>
						<header class="release__head">
							<h2 id={`release-${release.version}`} class="release__version">{release.version}</h2>
							<time class="code-label" datetime={release.date}>{longDate.format(new Date(`${release.date}T00:00:00Z`))}</time>
						</header>
						{release.sections.map((section) => (
							<section class="release__section">
								<h3 class="release__section-title">{section.title}</h3>
								<ul class="release__entries">
									{section.entries.map((entry) => (
										<li class="release__entry" data-change-type={entry.type}>
											<h4 class="release__summary">{entry.summary}</h4>
											<div class="release__details" set:html={entry.html} />
										</li>
									))}
								</ul>
							</section>
						))}
					</article>
				))
			)
		}
	</div>
</Base>

<style>
	.changelog-head {
		display: grid;
		gap: var(--s-5);
	}

	.changelog-head__title {
		font-size: var(--t-mega);
		line-height: 0.88;
		font-weight: 800;
		letter-spacing: -0.05em;
	}

	.changelog-head__body {
		font-size: var(--t-3);
		line-height: 1.4;
		max-width: 46ch;
	}

	.changelog-head__body a {
		color: inherit;
	}

	.release {
		display: grid;
		gap: var(--s-6);
	}

	.release__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s-3);
	}

	.release__version {
		font-size: var(--t-1);
		line-height: 0.95;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
	}

	.release__section {
		display: grid;
		gap: var(--s-4);
	}

	.release__section-title {
		font-family: var(--font-mono);
		font-size: var(--t-micro);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--chip-muted);
	}

	.release__entries {
		display: grid;
		gap: var(--s-5);
		padding: 0;
		list-style: none;
	}

	.release__entry {
		display: grid;
		gap: var(--s-2);
		max-width: var(--measure);
	}

	.release__summary {
		font-size: var(--t-3);
		line-height: var(--lh-snug);
		letter-spacing: -0.02em;
	}

	.release__details {
		color: var(--chip-muted);
		line-height: var(--lh-body);
	}

	.release__details :global(p + p) {
		margin-top: var(--s-3);
	}

	.release__empty {
		font-size: var(--t-3);
	}
</style>
