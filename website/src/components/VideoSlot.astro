---
/**
 * The launch film. `video/` renders it from real canvist output and writes
 * its poster to `assets/brand/video-poster.png`. The MP4 isn't hosted yet,
 * so the slot shows the poster, marked as coming soon. To ship the film, put
 * the MP4 in `public/media/` and pass its path as `src`; the 16:9 box stays
 * the same, so nothing shifts.
 */
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

interface Props {
	poster: ImageMetadata;
	src?: string;
	class?: string;
}

const { src, poster, class: className } = Astro.props;
const posterUrl = src === undefined ? undefined : (await getImage({ src: poster, width: 1280, format: "webp" })).src;
---

<figure class:list={["film", className]} data-video-slot>
	{
		src ? (
			<video controls playsinline preload="none" poster={posterUrl} aria-label="canvist launch film">
				<source src={src} type="video/mp4" />
			</video>
		) : (
			<div class="film__frame">
				<Image
					src={poster}
					alt="A frame from the launch film: Markdown typed into canvist snaps into headings, lists, a quote, a task and a code block."
					widths={[480, 720, 960]}
					sizes="(max-width: 64rem) calc(100vw - 4rem), 30rem"
					format="webp"
					loading="lazy"
					decoding="async"
				/>
				<span class="film__badge" aria-hidden="true">
					<svg viewBox="0 0 64 64" class="film__play">
						<circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 5"></circle>
						<path d="M26 21v22l18-11Z" fill="currentColor"></path>
					</svg>
				</span>
			</div>
		)
	}
	<figcaption class="code-label">
		<span>Launch film</span>
		<span>{src ? "Rendered from real canvist output" : "Coming soon"}</span>
	</figcaption>
</figure>

<style>
	.film {
		display: grid;
		gap: var(--s-2);
		padding: var(--s-2);
		border-radius: calc(var(--r-2) + var(--s-2));
		background: color-mix(in oklab, var(--chip-fg, var(--text)) 6%, transparent);
	}

	video,
	.film__frame {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: var(--r-2);
		background: var(--ink);
		overflow: hidden;
	}

	.film__frame {
		position: relative;
	}

	.film__frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* A quiet play mark: the film exists, it just isn't hosted yet. */
	.film__badge {
		position: absolute;
		right: var(--s-3);
		bottom: var(--s-3);
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: color-mix(in oklab, var(--ink) 70%, transparent);
		color: var(--paper);
	}

	.film__play {
		width: 2rem;
		height: 2rem;
	}

	figcaption {
		display: flex;
		justify-content: space-between;
		gap: var(--s-3);
		padding: 0 var(--s-1);
		color: var(--chip-muted, var(--text-muted));
	}
</style>
