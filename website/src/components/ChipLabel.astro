---
import { chipFor } from "../lib/deck.ts";

interface Props {
	/** The deck chip this label belongs to. */
	id: string;
	/** The swatch code printed at the right: a real number from this section. */
	code: string;
}

const { id, code } = Astro.props;
const chip = chipFor(id);
---

<p class="chip-label">
	<b>No. {chip.number}</b>
	<span>{chip.name}</span>
	<span class="chip-label__code">{code}</span>
</p>
