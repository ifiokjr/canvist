---
import ChipLabel from "../ChipLabel.astro";

// Hand-tokenised so the error can land on one exact token. Each entry is one line.
const lines = [
	`<span class="k">import</span> { createEditor } <span class="k">from</span> <span class="s">"@canvist/core"</span>;`,
	`<span class="k">import</span> { StarterKit } <span class="k">from</span> <span class="s">"@canvist/starter-kit"</span>;`,
	`<span class="k">import</span> { Highlight } <span class="k">from</span> <span class="s">"@canvist/highlight"</span>;`,
	``,
	`<span class="k">const</span> editor = <span class="f">createEditor</span>({`,
	`  extensions: [StarterKit<span class="ext">, <span class="ext__name">Highlight</span></span>],`,
	`});`,
	``,
	`editor.commands.<span class="f">toggleBold</span>();`,
	`editor.commands.<span class="f">setBlock</span>(<span class="s">"heading"</span>, { level: <span class="n">2</span> });`,
	`editor.commands.<span class="f squiggle">toggleHighlight</span>({ color: <span class="s">"#8A80FF"</span> });`,
];
const ERROR_LINE = lines.length - 1;
---

<section class="chip typed" data-chip="4" id="typed" aria-labelledby="typed-title" data-fan-chip>
	<div class="chip-inner typed__grid" data-typed data-highlight="on">
		<div class="typed__copy">
			<p class="eyebrow">05 / Headless and typed</p>
			<h2 id="typed-title" class="section-title">Forget an extension, get a compile error.</h2>
			<p class="lede chip-muted">
				The core never touches the DOM, so it runs in tests, on servers and in agents. The editor's type is inferred from the extensions you register: call a command you didn't install and TypeScript stops you before the browser does.
			</p>
			<div class="typed__toggle">
				<button type="button" class="switch" role="switch" aria-checked="true" data-typed-switch>
					<span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
					<span>Register <code>Highlight</code></span>
				</button>
			</div>
			<p class="typed__note code-label chip-muted">Preview of the v2 TypeScript API. The types are generated from each extension's metadata in milestone M3.</p>
		</div>

		<figure class="ide" aria-labelledby="ide-caption">
			<div class="ide__bar" aria-hidden="true">
				<span class="ide__dots"><i></i><i></i><i></i></span>
				<span class="ide__file">editor.ts</span>
				<span class="ide__problems" data-typed-problems>0 problems</span>
			</div>
			<pre class="ide__code" tabindex="0" aria-label="editor.ts"><code>{
				lines.map((line, index) => (
					<span class:list={["ln", { "err-line": index === ERROR_LINE }]} data-n={index + 1} set:html={line} />
				))
			}</code></pre>
			<div class="ide__error" role="status" data-typed-error>
				<p><span class="ide__code-id">ts(2339)</span> Property <code>'toggleHighlight'</code> does not exist on type <code>'Commands&lt;[StarterKit]&gt;'</code>.</p>
				<p class="ide__hint">Register <code>Highlight</code> in <code>extensions</code> to use it.</p>
			</div>
			<figcaption id="ide-caption" class="visually-hidden">
				TypeScript example. With Highlight registered the code type-checks. Without it, calling editor.commands.toggleHighlight is error 2339: the property does not exist.
			</figcaption>
		</figure>
	</div>
	<ChipLabel id="typed" code="Typed handles: TypeScript, Rust, Swift, Kotlin, Dart" />
</section>

<script>
	import { mountTyped } from "../../scripts/typed.ts";

	const root = document.querySelector<HTMLElement>("[data-typed]");
	if (root) mountTyped(root);
</script>

<style>
	.typed__grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: var(--s-7) var(--s-8);
		align-items: center;
	}

	.typed__copy {
		display: grid;
		gap: var(--s-5);
	}

	.typed code {
		font-size: 0.9em;
	}

	.switch {
		display: inline-flex;
		align-items: center;
		gap: var(--s-3);
		min-height: 2.75rem;
		padding: 0 var(--s-4) 0 var(--s-2);
		border: 2px solid currentColor;
		border-radius: 999px;
		background: transparent;
		font-weight: 620;
		cursor: pointer;
	}

	.switch__track {
		position: relative;
		width: 2.75rem;
		height: 1.5rem;
		border-radius: 999px;
		background: color-mix(in oklab, var(--chip-fg) 25%, transparent);
		transition: background-color var(--dur-2) var(--ease-out);
	}

	.switch__thumb {
		position: absolute;
		top: 0.1875rem;
		left: 0.1875rem;
		width: 1.125rem;
		height: 1.125rem;
		border-radius: 50%;
		background: var(--chip-fg);
		transition: transform var(--dur-2) var(--ease-out);
	}

	.switch[aria-checked="true"] .switch__track {
		background: var(--paper);
	}

	.switch[aria-checked="true"] .switch__thumb {
		background: var(--paint);
		transform: translateX(1.25rem);
	}

	/* ---------- The editor window ---------- */

	.ide {
		border-radius: var(--r-2);
		background: #121019;
		color: #e6e3f5;
		box-shadow: 0 36px 70px -40px #000;
		overflow: hidden;
	}

	.ide__bar {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		padding: var(--s-2) var(--s-4);
		border-bottom: 1px solid #262233;
		font-family: var(--font-mono);
		font-size: var(--t-micro);
		color: #a8a2c2;
	}

	.ide__dots {
		display: flex;
		gap: 6px;
	}

	.ide__dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #2e2940;
	}

	.ide__problems {
		margin-left: auto;
	}

	[data-highlight="off"] .ide__problems {
		color: #ff7a93;
	}

	.ide__code {
		margin: 0;
		padding: var(--s-4) 0;
		overflow-x: auto;
		font-size: clamp(0.75rem, 1.15vw, 0.9375rem);
		line-height: 1.75;
		counter-reset: line;
	}

	.ln {
		display: block;
		min-height: 1.75em;
		padding: 0 var(--s-5) 0 0;
		white-space: pre;
	}

	.ln::before {
		content: attr(data-n);
		display: inline-block;
		width: 3.25em;
		padding-right: 1.25em;
		text-align: right;
		color: #5c5672;
	}

	.k {
		color: #b4abff;
	}

	.s {
		color: #9fe3c4;
	}

	.f {
		color: #f5f3ff;
		font-weight: 600;
	}

	.n {
		color: #ffc58a;
	}

	.ext {
		display: inline-block;
		transition:
			opacity var(--dur-2) var(--ease-out),
			filter var(--dur-2) var(--ease-out);
	}

	.ext__name {
		color: #8a80ff;
	}

	[data-highlight="off"] .ext {
		opacity: 0.35;
		text-decoration: line-through;
		text-decoration-color: #ff7a93;
		text-decoration-thickness: 2px;
	}

	.err-line {
		transition: background-color var(--dur-2) var(--ease-out);
	}

	[data-highlight="off"] .err-line {
		background: color-mix(in oklab, #ff3d63 16%, transparent);
	}

	[data-highlight="off"] .squiggle {
		text-decoration: underline wavy #ff5c7c;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.3em;
		text-decoration-skip-ink: none;
	}

	.ide__error {
		display: grid;
		gap: var(--s-1);
		margin: 0 var(--s-4) var(--s-4) 3.25em;
		padding: var(--s-3) var(--s-4);
		border-radius: var(--r-1);
		background: #2a1520;
		font-family: var(--font-mono);
		font-size: var(--t-micro);
		line-height: 1.6;
		transition:
			opacity var(--dur-2) var(--ease-out),
			transform var(--dur-2) var(--ease-out);
	}

	[data-highlight="on"] .ide__error {
		opacity: 0;
		transform: translateY(-0.5rem);
		visibility: hidden;
	}

	.ide__code-id {
		color: #ff7a93;
		margin-right: 0.5em;
	}

	.ide__hint {
		color: #a8a2c2;
	}

	@media (max-width: 64rem) {
		.typed__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 36rem) {
		.ide__error {
			margin-left: var(--s-4);
		}

		.ln::before {
			width: 2.25em;
			padding-right: 0.75em;
		}
	}
</style>
