---
---

<section class="beat together" id="together" aria-labelledby="together-title">
	<div class="chip-inner together__grid">
		<figure class="room" data-together>
			<canvas
				class="room__canvas"
				data-together-canvas
				role="img"
				aria-label="Four carets, Ada, Kofi, Mei and you, type into the same sentence at once. Each insertion shifts the carets after it, and the sentence ends up as: Meet me at the big blue canvas tonight."
			></canvas>
			<figcaption class="room__caption">
				<span data-together-log>4 people in this document</span>
				<span>Simulated here; live on canvist Sync.</span>
			</figcaption>
		</figure>

		<div class="together__copy">
			<h2 id="together-title" class="section-title">Write together.</h2>
			<p class="lede beat-muted">
				canvist speaks Yjs, so any Yjs peer can join. Everyone's caret stays exactly where they left it, even while others type in front of it.
			</p>
		</div>
	</div>
</section>

<script>
	import { mountTogether } from "../../scripts/together.ts";

	const root = document.querySelector<HTMLElement>("[data-together]");
	if (root) mountTogether(root);
</script>

<style>
	.together__grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: var(--s-7) var(--s-8);
		align-items: center;
	}

	.together__copy {
		display: grid;
		gap: var(--s-5);
	}

	.room {
		display: grid;
		gap: var(--s-3);
		margin: 0;
	}

	.room__canvas {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: var(--r-2);
		background: var(--raised);
		box-shadow:
			0 1px 0 color-mix(in oklab, var(--ink) 8%, transparent),
			0 24px 48px -32px color-mix(in oklab, var(--ink) 45%, transparent);
	}

	.room__caption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--s-1) var(--s-4);
		font-family: var(--font-mono);
		font-size: var(--t-micro);
		color: var(--text-muted);
	}

	@media (max-width: 64rem) {
		.together__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.together__copy {
			order: -1;
		}

		.room__canvas {
			aspect-ratio: 4 / 3;
		}
	}
</style>
