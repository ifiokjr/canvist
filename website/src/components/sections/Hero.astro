---
import poster from "../../../../assets/brand/video-poster.png";
import { lockup } from "../../lib/brand.ts";
import VideoSlot from "../VideoSlot.astro";

/** The swatches fanned behind the film: the rest of the deck, as colour only. */
const swatches = [1, 2, 3, 4, 7] as const;
---

<section class="chip hero" data-chip="0" id="top" aria-labelledby="hero-title">
	<div class="chip-inner hero__grid">
		<div class="hero__stage" data-hero-stage data-state="waiting">
			<div class="hero__lockup" data-hero-lockup set:html={lockup} />
			<canvas class="hero__rive" data-hero-rive aria-hidden="true" width="960" height="256"></canvas>
		</div>

		<div class="hero__copy">
			<h1 id="hero-title" class="hero__title">The rich-text editor that paints every pixel itself.</h1>
			<p class="hero__lede chip-muted">
				One Rust core lays out and paints your text on a canvas, on the web, desktop, mobile and every cross-platform toolkit.
			</p>
			<div class="hero__actions">
				<a class="btn" href="/docs/getting-started" data-astro-prefetch>Start building</a>
				<a class="btn btn--ghost" href="https://github.com/ifiokjr/canvist">Read the source</a>
			</div>
		</div>

		<div class="hero__film">
			<div class="fan" aria-hidden="true">
				{swatches.map((chip, index) => <span style={`--i: ${index}; --fan-bg: var(--chip-${chip});`} />)}
			</div>
			<VideoSlot poster={poster} />
		</div>
	</div>
</section>

<style>
	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		grid-template-areas:
			"stage stage"
			"copy film";
		gap: var(--s-7) var(--s-8);
		align-items: end;
	}

	.hero__stage {
		grid-area: stage;
		position: relative;
		width: min(100%, 52rem);
		aspect-ratio: 240.1 / 64;
	}

	.hero__lockup,
	.hero__rive {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__lockup :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hero__rive {
		opacity: 0;
	}

	/* Once Rive paints, its canvas replaces the static master. */
	.hero__stage[data-state="rive"] .hero__rive {
		opacity: 1;
	}

	.hero__stage[data-state="rive"] .hero__lockup {
		visibility: hidden;
	}

	/*
	 * Waiting for the painter: the wordmark is not on the canvas yet and the
	 * caret blinks where the stroke will start. `motion-ok` is set before first
	 * paint (see Base.astro), so the full lockup never flashes. If no script
	 * takes over, the CSS stroke below starts on its own.
	 */
	:global(.motion-ok) .hero__stage[data-state="waiting"] .hero__lockup :global(path:not(.logo-caret)) {
		animation: paint-reveal-late 1.4s var(--ease-paint) 2.8s both;
	}

	:global(.motion-ok) .hero__stage[data-state="waiting"] .hero__lockup :global(.logo-caret) {
		transform-box: view-box;
		animation:
			paint-sweep-late 1.4s var(--ease-paint) 2.8s both,
			caret-blink 1.06s steps(1, end) infinite;
	}

	/* Rive missed its deadline or failed: paint the stroke in CSS now. */
	:global(.motion-ok) .hero__stage[data-state="css"] .hero__lockup :global(path:not(.logo-caret)) {
		animation: paint-reveal 1.4s var(--ease-paint) both;
	}

	:global(.motion-ok) .hero__stage[data-state="css"] .hero__lockup :global(.logo-caret) {
		transform-box: view-box;
		animation:
			paint-sweep 1.4s var(--ease-paint) both,
			caret-blink 1.06s steps(1, end) 1.6s infinite;
	}

	@keyframes caret-blink {
		0%,
		50% {
			opacity: 1;
		}

		50.01%,
		100% {
			opacity: 0;
		}
	}

	@keyframes paint-reveal {
		from {
			clip-path: inset(0 100% 0 0);
		}

		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@keyframes paint-sweep {
		from {
			transform: translateX(-92.9%);
		}

		to {
			transform: translateX(0);
		}
	}

	/* Same strokes under new names: switching names restarts the animation. */
	@keyframes paint-reveal-late {
		from {
			clip-path: inset(0 100% 0 0);
		}

		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@keyframes paint-sweep-late {
		from {
			transform: translateX(-92.9%);
		}

		to {
			transform: translateX(0);
		}
	}

	.hero__copy {
		grid-area: copy;
		display: grid;
		gap: var(--s-5);
	}

	.hero__title {
		font-size: clamp(2.125rem, 4.2vw, 3.75rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
		font-weight: 760;
		max-width: 15ch;
	}

	.hero__lede {
		font-size: var(--t-3);
		line-height: 1.42;
		max-width: 34ch;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
	}

	.hero__film {
		grid-area: film;
		position: relative;
		isolation: isolate;
	}

	/*
	 * The rest of the deck, fanned behind the film: colour only, no labels.
	 * It opens once on load; under reduced motion it is simply open.
	 */
	.fan {
		position: absolute;
		z-index: -1;
		left: -1.5rem;
		bottom: 22%;
		width: 58%;
		height: 2.25rem;
	}

	/* Pivoting on their right ends, under the film, the swatches open up and to the left. */
	.fan span {
		position: absolute;
		inset: 0;
		border-radius: 0.75rem;
		background: var(--fan-bg);
		transform-origin: calc(100% - 1.25rem) 50%;
		transform: rotate(calc(var(--i) * 7deg + 4deg));
	}

	:global(.motion-ok) .fan span {
		animation: fan-open 1.1s var(--ease-wet) calc(0.9s + var(--i) * 60ms) both;
	}

	@keyframes fan-open {
		from {
			transform: rotate(0deg);
		}
	}

	@media (max-width: 64rem) {
		.hero__grid {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				"stage"
				"copy"
				"film";
			gap: var(--s-6);
		}

		.fan {
			display: none;
		}
	}
</style>
