---
import { platforms } from "../../data/platforms.ts";

/** One small document, the same in every frame. */
const doc = {
	title: "Field notes",
	body: "The caret is still <strong>wet</strong>. One Rust core painted every glyph here.",
	items: [
		{ text: "Measure", done: true },
		{ text: "Lay out", done: true },
		{ text: "Paint", done: false },
	],
};
---

<section class="chip everywhere" data-chip="2" id="everywhere" aria-labelledby="everywhere-title" data-settle>
	<div class="chip-inner everywhere__grid" data-everywhere>
		<div class="everywhere__copy">
			<h2 id="everywhere-title" class="section-title">One core. Every platform.</h2>
			<p class="lede chip-muted">
				Each host only gives canvist a surface to paint on and a way to read keys, so the same document looks the same everywhere.
			</p>
			<div class="hosts" role="tablist" aria-label="Platforms">
				{
					platforms.map((platform, index) => (
						<button
							type="button"
							role="tab"
							id={`host-tab-${platform.id}`}
							aria-controls={`host-${platform.id}`}
							aria-selected={index === 0 ? "true" : "false"}
							tabindex={index === 0 ? 0 : -1}
							data-host={platform.id}
							data-live={platform.status === "live" ? "" : undefined}
						>
							{platform.name}
						</button>
					))
				}
			</div>
			<p class="everywhere__note chip-muted">
				<span class="dot dot--live" aria-hidden="true"></span> runs today. <a href="/docs/quick-start#whats-available-today" data-astro-prefetch>See what's available on each platform</a>.
			</p>
		</div>

		<div class="stage" aria-live="polite">
			{
				platforms.map((platform, index) => (
					<div
						class="device"
						id={`host-${platform.id}`}
						role="tabpanel"
						aria-labelledby={`host-tab-${platform.id}`}
						data-device={platform.id}
						data-active={index === 0 ? "" : undefined}
						hidden={index === 0 ? undefined : true}
					>
						<div class="device__bar" aria-hidden="true">
							<i />
							<i />
							<i />
						</div>
						<div class="device__screen">
							<article class="doc">
								<h3>{doc.title}</h3>
								<p set:html={doc.body} />
								<ul>
									{doc.items.map((item) => <li data-done={item.done ? "" : undefined}>{item.text}</li>)}
								</ul>
							</article>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import { platforms } from "../../data/platforms.ts";
	import { mountEverywhere } from "../../scripts/everywhere.ts";

	const root = document.querySelector<HTMLElement>("[data-everywhere]");
	if (root) mountEverywhere(root, platforms);
</script>

<style>
	.everywhere__grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: var(--s-7) var(--s-8);
		align-items: center;
	}

	.everywhere__copy {
		display: grid;
		gap: var(--s-5);
		align-content: start;
	}

	.hosts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
	}

	.hosts button {
		display: inline-flex;
		align-items: center;
		gap: var(--s-2);
		min-height: 2.75rem;
		padding: 0 var(--s-4);
		border: 1px solid color-mix(in oklab, var(--chip-fg) 28%, transparent);
		border-radius: 999px;
		background: transparent;
		font-size: var(--t-small);
		font-weight: 600;
		cursor: pointer;
		transition:
			background-color var(--dur-2) var(--ease-wet),
			color var(--dur-2) var(--ease-wet);
	}

	.hosts button[data-live]::before,
	.dot--live {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
	}

	.hosts button[aria-selected="true"] {
		background: var(--chip-fg);
		color: var(--chip-bg);
		border-color: var(--chip-fg);
	}

	.hosts button[aria-selected="true"][data-live]::before {
		background: var(--chip-bg);
	}

	.everywhere__note {
		font-size: var(--t-small);
	}

	/* ---------- The stage: every device is stacked here and crossfades ---------- */

	.stage {
		position: relative;
		aspect-ratio: 4 / 3;
	}

	.device {
		--ratio: 16 / 10;
		position: absolute;
		inset: 0;
		margin: auto;
		display: grid;
		grid-template-rows: 1.75rem minmax(0, 1fr);
		width: 100%;
		max-width: 100%;
		max-height: 100%;
		aspect-ratio: var(--ratio);
		padding: 0 0.375rem 0.375rem;
		border-radius: 0.875rem;
		background: var(--ink);
		box-shadow: 0 30px 50px -34px color-mix(in oklab, var(--ink) 70%, transparent);
		opacity: 1;
		transform: none;
		transition:
			opacity 450ms var(--ease-wet),
			transform 650ms var(--ease-wet);
	}

	/* The hidden frames stay in the stack so the crossfade has something to fade. */
	.device[hidden] {
		display: grid;
		visibility: hidden;
		opacity: 0;
		transform: translateY(0.75rem) scale(0.97);
		transition:
			opacity 300ms var(--ease-wet),
			transform 300ms var(--ease-wet),
			visibility 0s linear 300ms;
	}

	.device[data-device="desktop"] {
		--ratio: 4 / 3;
		width: 92%;
	}

	.device[data-device="flutter"] {
		--ratio: 4 / 3;
		width: 88%;
		padding: 0 0.75rem 0.75rem;
		border-radius: 1.25rem;
	}

	.device:is([data-device="ios"], [data-device="android"], [data-device="react-native"], [data-device="lynx"]) {
		--ratio: 9 / 18;
		width: auto;
		height: 100%;
		padding: 0 0.5rem 0.5rem;
		border-radius: 2rem;
	}

	.device[data-device="android"] {
		border-radius: 1.5rem;
	}

	.device__bar {
		display: flex;
		align-items: center;
		gap: 5px;
		padding-inline: 0.5rem;
	}

	.device__bar i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: color-mix(in oklab, var(--paper) 35%, transparent);
	}

	.device:is([data-device="ios"], [data-device="android"], [data-device="react-native"], [data-device="lynx"]) .device__bar {
		justify-content: center;
	}

	.device:is([data-device="ios"], [data-device="android"], [data-device="react-native"], [data-device="lynx"]) .device__bar i:not(:first-child) {
		display: none;
	}

	.device:is([data-device="ios"], [data-device="react-native"], [data-device="lynx"]) .device__bar i:first-child {
		width: 3.5rem;
		height: 0.875rem;
		border-radius: 999px;
		background: #000;
	}

	.device__screen {
		/* Text scales with the screen, so every frame fits its document. */
		container-type: size;
		min-height: 0;
		border-radius: calc(0.875rem - 0.375rem);
		background: var(--paper);
		color: var(--ink);
		overflow: hidden;
	}

	.device:is([data-device="ios"], [data-device="android"], [data-device="react-native"], [data-device="lynx"]) .device__screen {
		border-radius: 1.5rem;
	}

	.doc {
		display: grid;
		align-content: start;
		gap: 0.6em;
		padding: 8cqmin;
		font-size: clamp(0.5rem, min(4.6cqi, 7cqb), 1.0625rem);
		line-height: 1.45;
	}

	.doc h3 {
		font-size: 1.55em;
		line-height: 1.05;
	}

	.doc :global(strong) {
		color: var(--paint);
	}

	.doc ul {
		display: grid;
		gap: 0.3em;
		padding: 0;
		list-style: none;
	}

	.doc li {
		display: flex;
		align-items: center;
		gap: 0.55em;
	}

	.doc li::before {
		content: "";
		flex: none;
		width: 1em;
		height: 1em;
		border: 0.12em solid var(--ink);
		border-radius: 0.25em;
	}

	.doc li[data-done]::before {
		border-color: var(--paint);
		background: var(--paint);
	}

	@media (max-width: 64rem) {
		.everywhere__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
