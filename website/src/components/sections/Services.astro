---
import { services } from "../../data/services.ts";
import ChipLabel from "../ChipLabel.astro";
---

<section class="chip services" data-chip="7" id="services" aria-labelledby="services-title" data-fan-chip>
	<div class="chip-inner services__inner">
		<div class="services__head">
			<p class="eyebrow">08 / Services</p>
			<h2 id="services-title" class="section-title">Pay only for what we run for you.</h2>
			<p class="lede chip-muted">
				canvist Cloud hosts the servers the editor talks to. Every one is open source and you can self-host the exact binary we deploy. You're billed per monthly active document, on any platform.
			</p>
		</div>
		<ol class="swatches">
			{
				services.map((service, index) => (
					<li class="swatch" style={`--n: ${index}`}>
						<a href={`/services/${service.id}`} class="swatch__link" data-astro-prefetch>
							<span class="swatch__top">
								<span class="code-label">canvist</span>
								<span class="status" data-status={service.status === "next" ? "planned" : "building"}>
									{service.statusText}
								</span>
							</span>
							<span class="swatch__name">{service.name}</span>
							<span class="swatch__tagline">{service.tagline}</span>
							<span class="swatch__more code-label">How {service.name} works</span>
						</a>
					</li>
				))
			}
		</ol>
		<p class="services__pricing">
			<a href="/pricing" data-astro-prefetch>See preview pricing</a>
			<span class="chip-muted">Hobby is free up to 1,000 monthly active documents.</span>
		</p>
	</div>
	<ChipLabel id="services" code="Billed per monthly active document" />
</section>

<style>
	.services__inner {
		display: grid;
		gap: var(--s-7);
	}

	.services__head {
		display: grid;
		gap: var(--s-5);
	}

	.services__head .section-title {
		max-width: 18ch;
	}

	.swatches {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--s-4);
		padding: 0;
		list-style: none;
	}

	.swatch__link {
		--sw-bg: color-mix(in oklab, var(--chip-fg) calc(8% + var(--n) * 5%), var(--chip-bg));
		position: relative;
		display: grid;
		grid-template-rows: auto auto 1fr auto;
		gap: var(--s-3);
		height: 100%;
		min-height: 20rem;
		padding: var(--s-5);
		padding-top: var(--s-6);
		border-radius: var(--r-2);
		background: var(--sw-bg);
		text-decoration: none;
		transition: transform var(--dur-2) var(--ease-out);
	}

	.swatch__link::before {
		content: "";
		position: absolute;
		top: var(--s-3);
		left: 50%;
		width: 0.75rem;
		height: 0.75rem;
		margin-left: -0.375rem;
		border-radius: 50%;
		background: var(--chip-bg);
	}

	.swatch__link:hover {
		transform: translateY(-0.375rem) rotate(-0.6deg);
	}

	.swatch__top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--s-2);
	}

	.swatch__name {
		font-size: var(--t-1);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	.swatch__tagline {
		font-size: var(--t-3);
		line-height: 1.3;
		color: var(--chip-muted);
	}

	.swatch__more {
		padding-top: var(--s-3);
		border-top: 1px solid color-mix(in oklab, var(--chip-fg) 22%, transparent);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.services__pricing {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-4);
		align-items: baseline;
		font-size: var(--t-3);
	}

	.services__pricing a {
		font-weight: 680;
	}

	@media (max-width: 56rem) {
		.swatches {
			grid-template-columns: minmax(0, 1fr);
		}

		.swatch__link {
			min-height: 0;
		}
	}
</style>
