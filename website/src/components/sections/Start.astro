---
import { GITHUB_URL, mark } from "../../lib/brand.ts";
import ChipLabel from "../ChipLabel.astro";
---

<section class="chip start" data-chip="4" id="start" aria-labelledby="start-title" data-fan-chip>
	<div class="chip-inner start__inner">
		<div class="start__mark" aria-hidden="true" set:html={mark} />
		<div class="start__copy">
			<p class="eyebrow">09 / Start painting</p>
			<h2 id="start-title" class="start__title">Pick up the brush.</h2>
			<p class="lede">Read how the core works, run the v1 demo locally, or follow v2 as it lands, one milestone at a time.</p>
			<div class="start__actions">
				<a class="btn start__primary" href="/docs/getting-started" data-astro-prefetch>Get started</a>
				<a class="btn btn--ghost" href={GITHUB_URL}>Star on GitHub</a>
				<a class="btn btn--ghost" href="/docs/v2/roadmap" data-astro-prefetch>See the roadmap</a>
			</div>
			<pre class="start__shell" tabindex="0"><code><span aria-hidden="true">$ </span>git clone https://github.com/ifiokjr/canvist</code></pre>
		</div>
	</div>
	<ChipLabel id="start" code="Paint #3B2CF5 · still wet" />
</section>

<style>
	.start__inner {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: var(--s-7) var(--s-8);
		align-items: center;
	}

	/* The mark in mono white on Paint: the caret takes the single mono colour. */
	.start__mark {
		--logo-ink: var(--paper);
		--logo-paint: var(--paper);
		width: min(100%, 22rem);
		justify-self: center;
	}

	.start__mark :global(svg) {
		width: 100%;
		height: auto;
	}

	.start__copy {
		display: grid;
		gap: var(--s-5);
	}

	.start__title {
		font-size: var(--t-mega);
		line-height: 0.88;
		font-weight: 800;
		letter-spacing: -0.05em;
		max-width: 9ch;
	}

	.start__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
	}

	.start__primary {
		--btn-bg: var(--paper);
		--btn-fg: var(--paint);
	}

	.start .btn--ghost {
		color: var(--paper);
	}

	.start__shell {
		width: fit-content;
		max-width: 100%;
		padding: var(--s-3) var(--s-4);
		border-radius: var(--r-1);
		background: color-mix(in oklab, var(--ink) 55%, var(--paint));
		overflow-x: auto;
		font-size: var(--t-small);
	}

	.start .eyebrow {
		color: color-mix(in oklab, var(--paper) 80%, var(--paint));
	}

	@media (max-width: 56rem) {
		.start__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.start__mark {
			width: 8rem;
			justify-self: start;
		}
	}
</style>
