---
/**
 * The docs search: a trigger with a keyboard hint, and a modal that queries
 * the Pagefind index built by `deno task build`. Pagefind loads on first open.
 */
---

<button class="docs-search-open" type="button" aria-haspopup="dialog" aria-controls="docs-search" data-docs-search-open>
	<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
		<circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
		<path d="m13 13 4.25 4.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
	</svg>
	<span class="docs-search-open__label">Search<span class="docs-search-open__more"> docs</span></span>
	<kbd class="docs-search-open__kbd" data-docs-kbd>Ctrl K</kbd>
</button>

<dialog id="docs-search" class="docs-search" aria-labelledby="docs-search-label">
	<div class="docs-search__panel">
		<div class="docs-search__field" role="search">
			<label id="docs-search-label" class="visually-hidden" for="docs-search-input">Search the docs</label>
			<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
				<circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
				<path d="m13 13 4.25 4.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
			</svg>
			<input
				id="docs-search-input"
				type="search"
				role="combobox"
				aria-expanded="false"
				aria-controls="docs-search-results"
				aria-autocomplete="list"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
				enterkeyhint="go"
				placeholder="Search the docs"
			/>
			<button class="docs-search__close" type="button" data-docs-search-close>
				<kbd aria-hidden="true">Esc</kbd>
				<span class="visually-hidden">Close search</span>
			</button>
		</div>
		<div id="docs-search-results" class="docs-search__results" role="listbox" aria-label="Search results"></div>
		<p class="docs-search__status" role="status" data-docs-search-status>
			Search page titles, headings and text across the docs.
		</p>
		<p class="docs-search__keys" aria-hidden="true">
			<span><kbd>↑</kbd><kbd>↓</kbd> move</span>
			<span><kbd>↵</kbd> open</span>
			<span><kbd>Esc</kbd> close</span>
		</p>
	</div>
</dialog>

<script>
	import { mountDocsSearch } from "../../scripts/docs-search.ts";

	mountDocsSearch();
</script>
