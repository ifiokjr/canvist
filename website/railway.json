{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "website/Dockerfile",
		"watchPatterns": [
			"website/**",
			"docs/src/**",
			"assets/brand/**",
			"packages/canvist/**"
		]
	},
	"deploy": {
		"healthcheckPath": "/",
		"healthcheckTimeout": 60,
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	}
}
